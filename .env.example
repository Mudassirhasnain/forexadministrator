# External Economic Calendar API (Server-side only, never exposed to browser)
FINNHUB_API_KEY=

# Neon Serverless PostgreSQL Connection String (e.g. postgresql://user:pass@ep-xyz.us-east-1.aws.neon.tech/neondb?sslmode=require)
DATABASE_URL=

# Secret key for admin session verification and JWT authentication (must be set in production)
AUTH_SECRET=

# Secret key for authenticating Vercel Cron jobs or external schedulers (/api/cron/sync-calendar)
CRON_SECRET=

# Production site URL (used for canonical URLs, sitemaps, OpenGraph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://forexadministrator.vercel.app

# Finnhub Server-side Rate Limiting Configuration
FINNHUB_RPM_LIMIT=30
FINNHUB_MIN_REQUEST_INTERVAL_MS=1000

